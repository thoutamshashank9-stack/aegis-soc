# =============================================================================
# AEGIS SOC Threat Intelligence Platform - Production Environment Variables
# (DO NOT COMMIT REAL SECRETS TO VERSION CONTROL)
# =============================================================================

# --- Backend Web Service Settings (Render) ---
# Render assigns PORT dynamically
PORT=8000
HOST=0.0.0.0

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In production on Render: set to your deployed frontend URL (e.g., https://aegis-frontend.onrender.com)
FRONTEND_ORIGIN=*

# Database Connection URL:
# Local dev fallback: sqlite:///./email_threat_intelligence.db
# Render PostgreSQL: postgresql://user:password@dpg-xxxxx.render.com:5432/email_threat_db
DATABASE_URL=sqlite:///./email_threat_intelligence.db

# --- Optional External Intelligence Providers ---
# IP Geolocation API Key (ip-api.com pro / ipinfo.io). Optional; works without key.
GEOLOCATION_API_KEY=

# URL / Domain Reputation Provider (VirusTotal). Optional; heuristics run autonomously.
URL_REPUTATION_API_KEY=

# Optional LLM API Key (Autonomous TF-IDF & heuristic classifiers run without LLM)
LLM_API_KEY=

# --- Frontend Web Service Settings (Render Static Site / Web Service) ---
# URL pointing to the deployed FastAPI backend service
VITE_API_BASE_URL=https://your-backend-api.onrender.com
